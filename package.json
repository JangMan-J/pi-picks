{
  "name": "pi-picks",
  "version": "1.3.1",
  "description": "Keyboard-driven model picker for the pi coding agent: favorites, provider tabs, and one fuzzy query",
  "type": "module",
  "bin": {
    "pi-picks": "scripts/install.js"
  },
  "files": [
    "index.ts",
    "favorites.ts",
    "scripts/install.js",
    "SKILL.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "model",
    "selector",
    "fuzzy",
    "favorites",
    "tui"
  ],
  "author": "JangManJ",
  "contributors": [
    "Ilham Ramadhan"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangMan-J/pi-picks.git"
  },
  "bugs": {
    "url": "https://github.com/JangMan-J/pi-picks/issues"
  },
  "homepage": "https://github.com/JangMan-J/pi-picks#readme",
  "publishConfig": {
    "access": "public"
  }
}
